      "testRef": "test_standing_long_jump",
      "version": "1.0.0",
      "description": "Standing broad jump (standing long jump) from two-foot takeoff. Best of two attempts. Measured from takeoff line to nearest heel contact.",
      "startCondition": "Athlete stands behind takeoff line, feet shoulder-width apart. May use arm swing. Two-foot takeoff required.",
      "equipmentRequired": [
        "Measuring tape",
        "Flat non-slip surface",
        "Clearly marked takeoff line",
        "Judge or certified official"
      ],
      "equipmentProfile": "basic",
      "timingMethod": "n/a",
      "measurementStandard": "Nearest 0.5 inch (or 1 cm). Measured from takeoff line to back of nearest heel at landing. Best of two attempts recorded.",
      "invalidationRules": [
        "One-foot takeoff",
