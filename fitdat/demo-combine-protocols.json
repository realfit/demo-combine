      "equipmentRequired": [
        "Stopwatch",
        "Flat surface (turf or track)",
        "Measured 40-yard distance",
        "Judge or certified official"
      ],
      "equipmentProfile": "basic",
      "timingMethod": "hand",
      "measurementStandard": "Nearest 0.01 seconds. Best of two attempts recorded.",
